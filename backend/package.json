{
  "name": "upnex-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nodemon src/server.js",
    "start": "node src/server.js",
    "seed": "node prisma/seed.js",
    "db:push": "prisma db push",
    "postinstall": "prisma generate || (echo [!postinstall] prisma generate skipped - engine in use, run npm run db:push after stopping the server & exit 0)",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@dataconnect/generated": "file:src/dataconnect-generated",
    "@prisma/client": "^6.15.0",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.1",
    "firebase-admin": "^13.6.0",
    "google-auth-library": "^11.0.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.4.0",
    "pdf-parse": "^1.1.1",
    "tesseract.js": "^7.0.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "nodemon": "^3.1.10",
    "prisma": "^6.15.0",
    "vitest": "^3.2.4"
  }
}
