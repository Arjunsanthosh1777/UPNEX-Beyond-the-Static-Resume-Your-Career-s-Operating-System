# UPNEX backend environment variables.
# Copy this file to backend/.env and fill in the real values.

PORT=5000
NODE_ENV="development"

# --- Required ---
# Prisma uses the postgresql provider, so this must be a postgres:// string.
# Local dev: docker compose up -d  (see docker-compose.yml in the repo root).
#   DATABASE_URL="postgresql://upnex:upnex@localhost:5432/upnex?schema=public"
# Production (free host): paste the connection string from neon.tech.
DATABASE_URL="postgresql://upnex:upnex@localhost:5432/upnex?schema=public"

# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-me-use-a-long-random-secret"
CLIENT_URL="http://localhost:5173"

# Auth cookies become Secure automatically when NODE_ENV=production; override
# with COOKIE_SECURE=true (deployed HTTPS) or false (local HTTP).
COOKIE_SECURE=""

# --- Optional: Google sign-in via the legacy OAuth redirect ---
# Firebase Auth (below) is the recommended path and does not need these.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:5000/api/auth/google/callback"

# --- Firebase Admin (server-side ID token verification) ---
# Option A (local dev): download the service account key from Firebase Console
#   -> Project settings -> Service accounts, save it OUTSIDE the repo, and
#   point this env var at it.
GOOGLE_APPLICATION_CREDENTIALS=""
# Option B (deployed): the whole service account JSON on one line, newlines as \n.
FIREBASE_SERVICE_ACCOUNT_JSON=""
FIREBASE_PROJECT_ID="upnex-b702a"

# --- Object storage (Cloudflare R2 or any S3-compatible bucket) ---
# Set all four and every uploaded file (vault documents + profile photos/covers)
# is stored in the bucket, which survives redeploys. Leave empty to keep files
# on local disk (local dev). R2_ACCOUNT_ID is the long ID from the R2 Overview
# page; the API tokens must have "Object Read & Write" permission for the bucket.
#   - R2_ACCOUNT_ID="<account id from Cloudflare R2 dashboard>"
#   - R2_ACCESS_KEY_ID / R2_SECRET_ACCESS_KEY from "Manage R2 API Tokens"
#   - R2_BUCKET="upnex-files"
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
# Optional local override for where uploads land when R2 is unset.
STORAGE_DIR=""

# --- SMTP for real notification emails (Brevo / Resend free tiers) ---
# If SMTP_HOST is empty, emails are still recorded on the OutboxEmail ledger
# and logged to backend/logs/emails.log (the local fallback).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE="false"
MAIL_FROM="no-reply@upnex.ai"
MAIL_FROM_NAME="UPNEX"