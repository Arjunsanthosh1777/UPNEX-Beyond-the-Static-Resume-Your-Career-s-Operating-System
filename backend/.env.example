PORT=5000
# Prisma uses the sqlite provider in this project, so the URL must be a
# relative sqlite file path (NOT a postgres:// connection string).
DATABASE_URL="file:./dev.db"
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="ee658387ef7f9dfa62ed42429f07c3767125dba06524d3e1d95aa629ac2f3a8c76edca51005757606927e11c69c1a792"
CLIENT_URL="http://localhost:5173"
NODE_ENV="development"
# Optional — Google sign-in stays disabled until real credentials are set.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:5000/api/auth/google/callback"