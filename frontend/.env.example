# UPNEX frontend environment variables.
# Copy this file to frontend/.env and fill in the real values.
#
# Where to find them:
#   Firebase Console -> gear icon (Project settings) -> General tab
#   -> scroll to "Your apps" -> SDK setup and configuration -> Config
#
# These are inlined into the public JS bundle at build time. They are not
# secrets (the apiKey identifies the project, it does not authorise access),
# which is why Firebase ships them to the browser by design. Access control
# lives in firestore.rules, not in these values.

VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN="upnex-b702a.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="upnex-b702a"
VITE_FIREBASE_STORAGE_BUCKET="upnex-b702a.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
