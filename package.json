{
  "name": "upnex-insane-edtech",
  "private": true,
  "version": "2.0.0",
  "scripts": {
    "install:frontend": "npm install --prefix frontend",
    "install:backend": "npm install --prefix backend",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "predev": "npm install && npm install --prefix backend && npm install --prefix frontend",
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm:dev:backend\" \"npm:dev:frontend\"",
    "build": "npm run build --prefix frontend",
    "start": "npm run dev"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "dependencies": {
    "@dataconnect/generated": "file:src/dataconnect-generated",
    "firebase": "^12.19.0"
  }
}
